<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- ConsoleAppender: hien thi log ra man hinh voi dinh dang day du -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <!-- Dinh dang: [thoi_gian] [cap_do] [ten_logger] - noi_dung -->
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%level] [%logger{36}] - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- FileAppender: luu log vao file vat ly de tra cuu sau -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/application.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <!-- Xoay vong log moi ngay, giu lai 30 ngay -->
            <fileNamePattern>logs/application.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%level] [%logger{36}] [%thread] - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Root logger: cap do INFO, ghi ra ca Console va File -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

    <!-- Package-level logger: cho phep DEBUG cho com.lab trong moi truong dev -->
    <logger name="com.lab" level="DEBUG" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </logger>

</configuration>
